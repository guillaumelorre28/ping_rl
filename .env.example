# Modèle de .env : `cp .env.example .env` puis remplir.
# Le .env est lu par scripts/vast.sh ; les variables déjà exportées dans le
# shell gardent la priorité. Il est ignoré par git ET par Docker
# (.dockerignore) : une image publiée ne doit jamais embarquer ces clés.

# --- ClearML ---
# app.clear.ml -> Settings -> Workspace -> Create new credentials.
# Sans ces variables, l'entraînement tourne mais sans suivi ni sauvegarde
# distante des poids : n'utilisez alors PAS --auto-destroy.
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_API_HOST=https://api.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=...
CLEARML_API_SECRET_KEY=...

# --- vast.ai ---
# Image utilisée par scripts/vast.sh :
VAST_IMAGE=docker.io/glo28/ping-rl:latest
# VAST_DISK_GB=48    # taille du disque des instances
# VAST_MIN_CUDA=12.8 # doit suivre la variante CUDA de torch dans l'image :
#                    #   docker run --rm $VAST_IMAGE python -c \
#                    #     "import torch; print(torch.version.cuda)"
# VAST_DPH=0.35      # prix horaire de l'offre louée (colonne TOTAL de
#                    # `vast.sh search`) : alimente la métrique
#                    # train_cost_usd. Change à chaque offre — plutôt à
#                    # passer en ligne de commande qu'à figer ici.
# VAST_API_KEY=...   # sinon celle enregistrée par `vastai set api-key`
